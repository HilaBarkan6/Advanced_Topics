{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-pedantic",
                "-g",
                "main.cpp",
                "src/*.cpp",
                "src/game_objects/*.cpp",
                "src/implementations/*.cpp",
                "-o",
                "main.exe"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
        
    ]
}